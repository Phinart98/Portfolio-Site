---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'photoswipe/style.css';

interface Props { images: { src: ImageMetadata; alt: string }[]; }
const { images } = Astro.props;
---

<div class="gallery-root">
  <!-- Without JS each thumbnail opens its full-size image. With JS it opens
       PhotoSwipe: swipe, pinch or double-tap to zoom, drag to pan. -->
  <ul class="gallery">
    {images.map((img, i) => (
      <li>
        <a
          href={img.src.src}
          data-pswp-width={img.src.width}
          data-pswp-height={img.src.height}
          aria-label={`${img.alt || 'Photo'}, open photo ${i + 1} of ${images.length}`}
        >
          <Image src={img.src} alt={img.alt} widths={[360, 540, 720]} sizes="(min-width: 760px) 350px, (min-width: 560px) 50vw, 100vw" />
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.gallery-root').forEach((root) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery: root,
      children: 'a',
      // The viewer itself only downloads when someone opens a photo.
      pswpModule: () => import('photoswipe'),
      // Zoom is measured from the photo as it fits the screen, not from its
      // file size: the photos are small (1080px wide at most), so a fixed level
      // would jump far too close on a phone and do nothing on a laptop.
      secondaryZoomLevel: (z) => z.fit * 2.5,
      maxZoomLevel: (z) => z.fit * 5,
      bgOpacity: 1,
      padding: { top: 16, bottom: 16, left: 16, right: 16 },
      wheelToZoom: true,
      showHideAnimationType: still ? 'none' : 'zoom',
      zoomAnimationDuration: still ? 0 : 300,
      showAnimationDuration: still ? 0 : 300,
      hideAnimationDuration: still ? 0 : 250,
      arrowPrevTitle: 'Previous photo',
      arrowNextTitle: 'Next photo',
      closeTitle: 'Close',
      zoomTitle: 'Zoom in or out',
    });
    // Give the viewer a name, so screen readers announce more than "dialog".
    lightbox.on('afterInit', () => lightbox.pswp?.element?.setAttribute('aria-label', 'Photo viewer'));
    lightbox.init();
  });
</script>

<style>
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 560px) { .gallery { grid-template-columns: 1fr 1fr; } }
  .gallery a { display: block; border-radius: 6px; }
  .gallery :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; }

  /* PhotoSwipe adds its viewer at the end of <body>, so these are global. The
     viewer is always dark, whatever the site theme, so photos read well. */
  :global(.pswp) {
    --pswp-bg: #0E0D0C;
    --pswp-placeholder-bg: #1E1C1A;
    --pswp-icon-color: #F1EEE8;
    --pswp-icon-color-secondary: #0E0D0C;
    --pswp-icon-stroke-color: #0E0D0C;
    --pswp-error-text-color: #F1EEE8;
    font-family: var(--font-sans);
  }
  /* A flat band keeps the counter and buttons readable over a zoomed-in photo. */
  :global(.pswp__top-bar) { background: rgb(14 13 12 / 0.88); }
  :global(.pswp__counter) { font-size: 17px; text-shadow: none; opacity: 1; }
  :global(.pswp__button) { opacity: 1; }
  :global(.pswp__button:focus-visible) { outline: 3px solid #F0C674; outline-offset: -3px; border-radius: 6px; }
</style>
