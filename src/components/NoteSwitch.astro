---
import { NOTE } from '../data/note';
import { linkify } from '../utils/format';
---

<div class="note-block">
  <div class="note" data-voice="engineer">
    {NOTE.engineer.map((p) => <p set:html={linkify(p)} />)}
  </div>
  <div class="note" data-voice="plain" hidden>
    {NOTE.plain.map((p) => <p set:html={linkify(p)} />)}
  </div>

  <!-- Shown only with JS (the head script adds .js before paint), so without
       JS the page simply shows the engineer note. -->
  <fieldset class="switch">
    <legend>Read this as</legend>
    <label class="pill"><input type="radio" name="voice" value="engineer" checked autocomplete="off" /><span>an engineer</span></label>
    <label class="pill"><input type="radio" name="voice" value="plain" autocomplete="off" /><span>someone new to tech</span></label>
  </fieldset>
  <p class="sr-only-text" aria-live="polite" data-status></p>
</div>

<script>
  const block = document.querySelector('.note-block');
  const notes = block?.querySelectorAll<HTMLElement>('.note');
  const status = block?.querySelector<HTMLElement>('[data-status]');
  const switcher = block?.querySelector<HTMLFieldSetElement>('.switch');
  if (block && notes && status && switcher) {
    switcher.addEventListener('change', (e) => {
      const voice = (e.target as HTMLInputElement).value;
      notes.forEach((n) => {
        const on = n.dataset.voice === voice;
        n.hidden = !on;
        if (on) {
          // Restart the fade so it plays on every switch.
          n.classList.remove('entering');
          void n.offsetWidth;
          n.classList.add('entering');
        }
      });
      status.textContent = voice === 'plain' ? 'Showing the plain-language version.' : 'Showing the engineering version.';
    });
  }
</script>

<style>
  .note { max-width: 32em; }
  .note p { margin: 0 0 1em; }
  .note[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .note.entering { animation: note-in 180ms cubic-bezier(0.2, 0, 0, 1) both; }
    @keyframes note-in { from { opacity: 0; } to { opacity: 1; } }
  }
  .switch { border: 0; padding: 0; margin: 4px 0 28px; display: none; flex-wrap: wrap; align-items: center; gap: 8px 6px; font-size: 17px; }
  :global(.js) .switch { display: flex; }
  legend { float: left; width: 100%; margin-bottom: 6px; padding: 0; color: var(--muted); }
  @media (min-width: 640px) { legend { width: auto; margin: 0 8px 0 0; } }
</style>
