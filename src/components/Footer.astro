---
import { SITE, SOCIALS } from '../data/site';
---

<footer class="wrap">
  <p class="who">{SITE.name}</p>
  <ul>
    {SOCIALS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
    <li><a href="/rss.xml">RSS</a></li>
  </ul>
</footer>

<style>
  footer { margin-top: 96px; padding-top: 32px; padding-bottom: 48px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; font-size: 18px; }
  footer::before { content: ''; flex-basis: 100%; border-top: 1px solid var(--rule); margin-bottom: 24px; }
  .who { margin: 0; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; margin: 0; padding: 0; }
</style>
