---
import Base from '../../layouts/Base.astro';
import { PROJECTS } from '../../data/projects';
import { SHOW_PROJECTS } from '../../data/flags.mjs';

// The page is only built once projects are switched on, so the example
// entries are never published. A rest param with no value maps to /projects.
export function getStaticPaths() {
  return SHOW_PROJECTS ? [{ params: { index: undefined } }] : [];
}
---

<Base title="Projects" description="Things Philip Narteh has built.">
  <div class="wrap-narrow">
    <h1 class="page-title">Projects</h1>
    <p class="page-intro">Things I've built that people actually use.</p>
    <ul class="projects">
      {PROJECTS.map((p) => (
        <li>
          <h2><a href={p.href}>{p.name}</a></h2>
          <p class="status">{p.status}</p>
          <p>{p.what}</p>
          <p class="impact">{p.impact}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .projects { list-style: none; margin: 0; padding: 0; }
  .projects li { padding: 24px 0; border-top: 1px solid var(--rule); }
  h2 { margin: 0; font-size: 22px; line-height: 1.3; font-weight: 700; }
  h2 a { color: var(--ink); }
  .status { margin: 4px 0 10px; color: var(--muted); font-size: 17px; }
  .projects p { margin-top: 0; margin-bottom: 8px; max-width: 34em; }
  .impact { color: var(--muted); }
</style>
